{application, color_filter, [
    {description, "em_filter agent for color identification and harmonics"},
    {vsn, "0.2.0"},
    {registered, [color_filter_sup, color_filter_server]},
    {mod, {color_filter_app, []}},
    {applications, [kernel, stdlib, cowboy,
        em_filter]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        color_filter_sup,
        color_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/color_filter"}]}
]}.
